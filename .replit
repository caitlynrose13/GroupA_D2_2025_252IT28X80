modules = ["php-8.2", "web", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -d upload_max_filesize=500M -d post_max_size=500M -d max_execution_time=300 -d memory_limit=256M -S 0.0.0.0:5000 -t src/ src/router.php"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["php", "-d", "upload_max_filesize=500M", "-d", "post_max_size=500M", "-d", "max_execution_time=300", "-d", "memory_limit=256M", "-S", "0.0.0.0:5000", "-t", "src/"]
